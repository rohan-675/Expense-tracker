# Must include the /api prefix — e.g. https://your-backend-host.onrender.com/api
VITE_API_URL=https://your-backend-host.onrender.com/api

# Public Google OAuth Client ID (safe to expose — this is not a secret).
# Must be the exact same Client ID as GOOGLE_CLIENT_ID in server/.env.
# In Google Cloud Console, this OAuth Client's "Authorized JavaScript
# origins" must include every exact origin the frontend is ever loaded
# from (protocol + host, no path, no trailing slash) — e.g. both
# https://example.com AND https://www.example.com if both are used.
# Only "Authorized JavaScript origins" matters for this flow — this app
# does not use OAuth "Authorized redirect URIs" at all.
VITE_GOOGLE_CLIENT_ID=
