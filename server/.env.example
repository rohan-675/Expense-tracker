NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/expense-tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
# How many days the httpOnly auth cookie stays valid. Keep in sync with
# JWT_EXPIRES_IN above (both default to 7 days).
JWT_COOKIE_DAYS=7
CLIENT_URL=http://localhost:5173
# CLIENT_URL can be a comma-separated list if the frontend is reachable at
# more than one exact origin (e.g. a custom domain and its www. variant):
# CLIENT_URL=https://example.com,https://www.example.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_model_here

# Email verification — required for new registrations to receive a
# verification link. Any standard SMTP provider works (Gmail SMTP with an
# app password, SendGrid, Mailgun, Postmark, Amazon SES SMTP, etc).
# If left unset, accounts can still be created but no email will be sent —
# the server logs a warning at startup and logs the raw token to the
# console instead (for local development only, never in production).
EMAIL_HOST=your_smtp_host_here
EMAIL_PORT=587
EMAIL_USER=your_smtp_username_here
EMAIL_PASSWORD=your_smtp_password_here
EMAIL_FROM=your_verified_sender_address_here
# How many hours a verification link stays valid before expiring (default 24)
EMAIL_VERIFICATION_TTL_HOURS=24

# Receipt upload storage. Defaults to local disk if unset — fine for a host
# with a real persistent volume, but many platforms wipe local disk on every
# redeploy/restart. Set STORAGE_DRIVER=s3 to use an S3-compatible bucket
# instead (works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_ENDPOINT=            # only needed for non-AWS providers (R2/B2/Spaces)
# S3_FORCE_PATH_STYLE=false
