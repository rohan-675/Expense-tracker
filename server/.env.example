NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/expense-tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
# How many days the httpOnly auth cookie stays valid. Keep in sync with
# JWT_EXPIRES_IN above (both default to 7 days).
JWT_COOKIE_DAYS=7
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Receipt upload storage. Defaults to local disk if unset — fine for a host
# with a real persistent volume, but many platforms wipe local disk on every
# redeploy/restart. Set STORAGE_DRIVER=s3 to use an S3-compatible bucket
# instead (works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_ENDPOINT=            # only needed for non-AWS providers (R2/B2/Spaces)
# S3_FORCE_PATH_STYLE=false
